# =============================================================================
# Pharmaciano ERP — Environment Variables Example
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=pharmaciano-erp
APP_ENV=dev                        # dev | docker | staging | prod
APP_VERSION=0.1.0
APP_TIMEZONE=Asia/Dhaka

# -----------------------------------------------------------------------------
# HTTP Server (api)
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_MAX_HEADER_BYTES=1048576
SERVER_BODY_LIMIT_MB=5
SERVER_UPLOAD_LIMIT_MB=25
SERVER_TRUST_PROXY=true            # honour X-Forwarded-For from Nginx

# CORS — comma separated
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmaciano
DB_USER=postgres
DB_PASSWORD=89Sk90!7
DB_SSLMODE=disable                 # prefer/require/verify-full in prod
DB_TIMEZONE=UTC

# pgx pool
DB_POOL_MAX_CONNS=25
DB_POOL_MIN_CONNS=2
DB_POOL_MAX_CONN_LIFETIME=1h
DB_POOL_MAX_CONN_IDLE_TIME=30m
DB_POOL_HEALTH_CHECK_PERIOD=1m
DB_STATEMENT_TIMEOUT=30s

# Read replica (optional). Falls back to primary if empty.
DB_READ_HOST=
DB_READ_PORT=5432
DB_READ_USER=
DB_READ_PASSWORD=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# Asynq uses its own DB index
ASYNQ_REDIS_DB=1
ASYNQ_CONCURRENCY=20
ASYNQ_QUEUE_CRITICAL=6
ASYNQ_QUEUE_DEFAULT=3
ASYNQ_QUEUE_LOW=1

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
JWT_ISSUER=pharmaciano
JWT_AUDIENCE=pharmaciano-users
JWT_ALGORITHM=HS256                # HS256 for dev, RS256 for prod
JWT_SECRET=4f8c2a9d7b6e3f1c9a2d4e7f8b1c3d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1
JWT_KEY_ID=key-2026-07
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h         # 7 days
JWT_CLOCK_SKEW=30s

# RS256 (used when JWT_ALGORITHM=RS256)
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Refresh cookie
REFRESH_COOKIE_NAME=mc_refresh
REFRESH_COOKIE_DOMAIN=localhost
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false        # true in prod (HTTPS only)
REFRESH_COOKIE_SAMESITE=strict
REFRESH_COOKIE_HTTPONLY=true

# -----------------------------------------------------------------------------
# Password hashing (Argon2id)
# -----------------------------------------------------------------------------
ARGON2_MEMORY_KB=65536             # 64 MiB
ARGON2_TIME=3
ARGON2_PARALLELISM=2
ARGON2_KEY_LENGTH=32
ARGON2_SALT_LENGTH=16

# -----------------------------------------------------------------------------
# Field encryption (PII, bank accounts, salary, MFA secret)
# 32-byte base64 encoded key for AES-256-GCM
# -----------------------------------------------------------------------------
FIELD_ENCRYPTION_KEY=q9X5zYV7kzZfQm3hV9x9pKf2m7hTn4z5u8vW1x2y3zA=
FIELD_ENCRYPTION_KEY_ID=fe-2026-07

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_RPM=60
RATE_LIMIT_AUTH_READ_RPM=300
RATE_LIMIT_AUTH_WRITE_RPM=120
RATE_LIMIT_LOGIN_PER_EMAIL=5
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_POS_CHECKOUT_RPM=30
RATE_LIMIT_AI_PER_HOUR=20
RATE_LIMIT_EXPORT_PER_HOUR=5

# -----------------------------------------------------------------------------
# Casbin
# -----------------------------------------------------------------------------
CASBIN_MODEL_PATH=config/casbin_model.conf
CASBIN_AUTOSAVE=true

# -----------------------------------------------------------------------------
# Super Admin bootstrap (used only by cmd/seed on empty DB)
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=superadmin@pharmaciano.local
SUPER_ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstLogin_123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
ORG_NAME=Medico Drug House
ORG_SLUG=medico-drug-house
ORG_COUNTRY=Bangladesh
ORG_CURRENCY=BDT
ORG_TIMEZONE=Asia/Dhaka

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info                     # debug | info | warn | error
LOG_FORMAT=json                    # json | console
LOG_OUTPUT=stdout                  # stdout | file
LOG_FILE_PATH=./logs/app.log
LOG_SAMPLING=false

# -----------------------------------------------------------------------------
# Telemetry (OpenTelemetry / Prometheus)
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_LISTEN=127.0.0.1:9091

METRICS_AUTH_TOKEN=
HEALTH_EXPOSE_ERRORS=false

TRACING_ENABLED=false
OTEL_SERVICE_NAME=pharmaciano-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SAMPLING_RATIO=0.1

# -----------------------------------------------------------------------------
# WebSocket
# -----------------------------------------------------------------------------
WS_READ_BUFFER_BYTES=1024
WS_WRITE_BUFFER_BYTES=1024
WS_MAX_MESSAGE_BYTES=32768
WS_PING_INTERVAL=25s
WS_PONG_WAIT=60s
WS_WRITE_TIMEOUT=10s

# -----------------------------------------------------------------------------
# AI Provider (OpenAI / Anthropic / local)
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=openai                 # openai | anthropic | local
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=30s
AI_MAX_TOKENS=2048
AI_COST_CAP_USD_PER_DAY=5
AI_FORECAST_CACHE_TTL=6h
AI_CIRCUIT_BREAKER_ERROR_THRESHOLD=5
AI_CIRCUIT_BREAKER_TIMEOUT=60s

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local               # local | s3
STORAGE_LOCAL_PATH=./data/uploads
STORAGE_MAX_FILE_SIZE_MB=25
STORAGE_FSYNC_ON_WRITE=true
# S3-compatible (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"        # daily at 02:00 local time
BACKUP_LOCAL_PATH=./data/backups
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AI_FORECASTING=false
FEATURE_WEBSOCKET_NOTIFICATIONS=true
FEATURE_LEDGER_AUTOPOST=true
FEATURE_BRANCH_TRANSFERS=true

# -----------------------------------------------------------------------------
# Session / Security
# -----------------------------------------------------------------------------
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=168h
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION=15m

# -----------------------------------------------------------------------------
# Idempotency
# -----------------------------------------------------------------------------
IDEMPOTENCY_TTL=24h

# -----------------------------------------------------------------------------
# Dev-only extras (leave blank in prod)
# -----------------------------------------------------------------------------
PPROF_ENABLED=false
PPROF_LISTEN=127.0.0.1:6060

#------------------------------------------------------------------------------
# Mailer
#------------------------------------------------------------------------------
MAILER_DRIVER=noop
MAILER_FROM_EMAIL=no-reply@pharmaciano.local
MAILER_FROM_NAME=Pharmaciano ERP