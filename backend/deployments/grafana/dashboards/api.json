                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "id": 4,
            "options": {
                "displayMode": "gradient",
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "orientation": "horizontal",
                "showUnfilled": true
            },
            "targets": [
                {
                    "expr": "http_in_flight_requests",
                    "legendFormat": "In-flight",
                    "refId": "A"
                }
            ],
            "title": "In-Flight Requests",
            "type": "bargauge"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
