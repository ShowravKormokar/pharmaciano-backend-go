{
  "uid": "pharmaciano-auth-security",
  "title": "Auth & Security",
  "tags": ["pharmaciano", "auth", "security"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "title": "Login Attempts / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(auth_login_attempts_total[5m])) by (outcome) * 60",
          "legendFormat": "{{ outcome }}"
        }
      ]
    },
    {
      "title": "Login Success vs Failure Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          },
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "sum(rate(auth_login_attempts_total{outcome=\"success\"}[5m])) / sum(rate(auth_login_attempts_total[5m]))",
          "legendFormat": "Success Rate"
        }
      ]
    },
    {
      "title": "Account Lockouts",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(auth_account_lockouts_total[1h]))",
          "legendFormat": "Lockouts / hr"
        }
      ]
    },
    {
      "title": "Token Issued",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(rate(auth_tokens_issued_total[5m])) by (kind) * 60",
          "legendFormat": "{{ kind }} tokens/min"
        }
      ]
    },
    {
      "title": "Refresh Token Reuse Detected",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "increase(auth_refresh_reuse_detected_total[1h])",
          "legendFormat": "Reuse events / hr"
        }
      ]
    },
    {
      "title": "Refresh Attempts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(rate(auth_refresh_attempts_total[5m])) by (outcome) * 60",
          "legendFormat": "{{ outcome }}"
        }
      ]
    },
    {
      "title": "MFA Challenges",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(rate(auth_mfa_challenges_total[5m])) by (outcome) * 60",
          "legendFormat": "{{ outcome }}"
        }
      ]
    },
    {
      "title": "Password Changes & Resets",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(rate(auth_password_changes_total[5m])) by (outcome) * 60",
          "legendFormat": "change:{{ outcome }}"
        },
        {
          "expr": "sum(rate(auth_password_resets_issued_total[5m])) * 60",
          "legendFormat": "resets issued/min"
        },
        {
          "expr": "sum(rate(auth_password_resets_redeemed_total[5m])) * 60",
          "legendFormat": "resets redeemed/min"
        }
      ]
    },
    {
      "title": "Rate Limiting",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "targets": [
        {
          "expr": "sum(rate(rate_limited_total[5m])) by (policy)",
          "legendFormat": "{{ policy }}"
        }
      ]
    },
    {
      "title": "Security Denials",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(rate(security_denials_total[5m])) by (reason) * 60",
          "legendFormat": "{{ reason }}"
        }
      ]
    },
    {
      "title": "Authz Decisions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(rate(authz_decisions_total[5m])) by (decision) * 60",
          "legendFormat": "{{ decision }}"
        }
      ]
    },
    {
      "title": "Session Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(session_cache_hits_total[5m])) / (sum(rate(session_cache_hits_total[5m])) + sum(rate(session_cache_store_total[5m])))",
          "legendFormat": "Hit Rate"
        }
      ]
    },
    {
      "title": "Step-Up Auth Required",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "blue", "value": 0 },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(auth_step_up_required_total[1h]))",
          "legendFormat": "Step-ups / hr"
        }
      ]
    },
    {
      "title": "Authz Cache Errors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "increase(authz_cache_errors_total[1h])",
          "legendFormat": "Errors / hr"
        }
      ]
    }
  ]
}
